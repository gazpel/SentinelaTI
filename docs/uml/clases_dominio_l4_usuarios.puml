@startuml clases_dominio_l4_usuarios
' SentinelaTI - Dominio refinado (L4), parte 1: seguridad, usuarios y auditoría
' Render: java -jar plantuml.jar -graphvizdot <ruta>/dot.exe -tpng clases_dominio_l4_usuarios.puml
!include estilo_clases_l4.iuml

title Dominio refinado (L4) — seguridad, usuarios y auditoría

package "Seguridad y usuarios" {
  abstract class Usuario <<modificada>> {
    - idUsuario : UUID
    - nombre : String
    - correo : String
    - hashContrasena : String
    - activo : Boolean
    - intentosFallidos : Integer
    - bloqueadoHasta : DateTime [0..1]
    + autenticar(contrasena : String) : Boolean
    + cambiarContrasena(nueva : String) : void
    + desactivar() : void
    + estaBloqueado() : Boolean
    + {abstract} rol() : Rol
    + {abstract} tienePermiso(p : Permiso) : Boolean
  }
  class Tecnico <<modificada>> {
    + rol() : Rol
    + tienePermiso(p : Permiso) : Boolean
  }
  class Administrador <<modificada>> {
    + rol() : Rol
    + tienePermiso(p : Permiso) : Boolean
  }
  class Sesion {
    - idSesion : UUID
    - tokenJWT : String
    - fechaExpiracion : DateTime
    + estaVigente() : Boolean
    + cerrar() : void
  }
  enum Permiso <<nueva>> {
    ConsultarParque
    OrdenarAccion
    Formatear
    ConfigurarUmbrales
    GestionarUsuarios
    ConsultarBitacora
  }
  enum TipoAccion <<modificada>> {
    ReiniciarApagar
    InstalarApp
    ActualizarSO
    Formatear
    EscritorioRemoto
    --
    + permisoRequerido() : Permiso
  }
  Usuario <|-- Tecnico
  Tecnico <|-- Administrador
  Usuario "1" *-- "0..*" Sesion : abre >
  Usuario ..> Permiso
  TipoAccion .left.> Permiso
}

package "Auditoría" {
  class EntradaBitacora {
    - fechaOrden : DateTime
    - fechaResultado : DateTime [0..1]
    - tipoAccion : TipoAccion
    - estadoResultante : EstadoComando
    - nombreUsuario : String
    - nombreEquipo : String
    - cerrada : Boolean = false
    + cerrar(e : EstadoComando, f : DateTime) : void
    + esInmutable() : Boolean
  }
  class FiltroBitacora {
    + esValido() : Boolean
  }
}

class "Comando" as ComandoRef <<ref>>
Usuario "1" -- "0..*" ComandoRef : ordena >
EntradaBitacora "0..1" --> "0..1" ComandoRef : documenta >

note bottom of ComandoRef
  Definido en «Acciones remotas»
  (parte 3 del dominio).
end note
@enduml
