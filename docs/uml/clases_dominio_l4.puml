@startuml clases_dominio_l4
' SentinelaTI - Diagrama de clases refinado: capa de dominio del servidor (L4)
' Render: java -jar plantuml.jar -graphvizdot <ruta>/dot.exe -tpng clases_dominio_l4.puml
hide circle
hide empty members
skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName Calibri
skinparam defaultFontSize 11
skinparam nodesep 25
skinparam ranksep 45
skinparam ArrowColor #333333
skinparam ArrowFontSize 10
skinparam class {
  BackgroundColor #EAF4F5
  BorderColor #1F6F78
  FontColor #0B3C40
  AttributeFontSize 10
  BackgroundColor<<modificada>> #FFF1CC
  BorderColor<<modificada>> #B7791F
  BackgroundColor<<nueva>> #E3F2E1
  BorderColor<<nueva>> #2F7D32
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #1F6F78
  FontColor #1F6F78
}

title Diagrama de clases refinado (L4) — capa de dominio del servidor

package "Seguridad y usuarios" {
  abstract class Usuario <<modificada>> {
    - idUsuario : UUID
    - nombre : String
    - correo : String
    - hashContrasena : String
    - activo : Boolean
    - intentosFallidos : Integer
    - bloqueadoHasta : DateTime [0..1]
    + autenticar(contrasena : String) : Boolean
    + cambiarContrasena(nueva : String) : void
    + desactivar() : void
    + estaBloqueado() : Boolean
    + {abstract} rol() : Rol
    + {abstract} tienePermiso(p : Permiso) : Boolean
  }
  class Tecnico <<modificada>> {
    + rol() : Rol
    + tienePermiso(p : Permiso) : Boolean
  }
  class Administrador <<modificada>> {
    + rol() : Rol
    + tienePermiso(p : Permiso) : Boolean
  }
  class Sesion {
    - idSesion : UUID
    - tokenJWT : String
    - fechaExpiracion : DateTime
    + estaVigente() : Boolean
    + cerrar() : void
  }
  enum Permiso <<nueva>> {
    ConsultarParque
    OrdenarAccion
    Formatear
    ConfigurarUmbrales
    GestionarUsuarios
    ConsultarBitacora
  }
  enum TipoAccion <<modificada>> {
    ReiniciarApagar
    InstalarApp
    ActualizarSO
    Formatear
    EscritorioRemoto
    --
    + permisoRequerido() : Permiso
  }
  Usuario <|-- Tecnico
  Tecnico <|-- Administrador
  Usuario "1" *-- "0..*" Sesion : abre >
  Usuario ..> Permiso
  TipoAccion ..> Permiso
}

package "Monitoreo del parque" {
  class Equipo {
    - idEquipo : UUID
    - nombre : String
    - numeroSerie : String {unique}
    - direccionIP : String
    - ultimoUsuario : String
    - estado : EstadoEquipo
    - fechaUltimoReporte : DateTime
    + registrarLectura(l : Lectura) : void
    + evaluarEstado(c : ConfiguracionUmbrales) : EstadoEquipo
    + marcarDesconectado() : void
    + estaEnLinea() : Boolean
    + actualizarInventario(i : Inventario) : void
    + actualizarEstadoSO(e : EstadoActualizacionSO) : void
    + revocarTokenVigente() : void
  }
  class TokenAgente {
    - valor : String
    - revocado : Boolean
    + esValido() : Boolean
  }
  class Lectura {
    - marcaTiempo : DateTime
    - usoCPU : Real
    - usoRAM : Real
    - temperaturaCPU : Real [0..1]
    - horasEncendido : Real
    + valorDe(m : Metrica) : Real [0..1]
  }
  class UsoDisco {
    - unidad : String
    - usoPorcentaje : Real
  }
  class ParqueComputacional <<modificada>> {
    - nombre : String
    + listar(estado : EstadoEquipo [0..1]) : Equipo [0..*]
    + buscar(texto : String) : Equipo [0..*]
    + resumenPorEstado() : Map<EstadoEquipo, Integer>
  }
  class Inventario
  class EstadoActualizacionSO
  class AplicacionInstalada
  class ConfiguracionUmbrales {
    + umbralDe(m : Metrica) : Umbral
    + validar() : Boolean
  }
  class Umbral {
    - metrica : Metrica
    - valorAdvertencia : Real
    - valorCritico : Real
    + evaluar(valor : Real) : NivelAlerta
  }
  class Alerta {
    - metrica : Metrica [0..1]
    - nivel : NivelAlerta
    - fechaApertura : DateTime
    - fechaCierre : DateTime [0..1]
    + estaAbierta() : Boolean
    + cerrar() : void
  }
  Equipo "1" *-- "1..*" TokenAgente : emite >
  Equipo "1" *-- "0..*" Lectura : registra >
  Lectura "1" *-- "1..*" UsoDisco : detalla >
  ParqueComputacional "1" o-- "0..*" Equipo : agrupa >
  Equipo "1" *-- "0..1" Inventario : describe >
  Equipo "1" *-- "0..1" EstadoActualizacionSO : informa >
  Inventario "1" *-- "0..*" AplicacionInstalada : contiene >
  Equipo "1" -- "0..*" Alerta : presenta >
  ConfiguracionUmbrales "1" *-- "5" Umbral : define >
}

package "Acciones remotas" {
  abstract class Comando <<modificada>> {
    - idComando : UUID
    - estado : EstadoComando
    - fechaOrden : DateTime
    - fechaResultado : DateTime [0..1]
    - motivoFallo : String [0..1]
    # simulado : Boolean
    + {abstract} tipo() : TipoAccion
    + {abstract} interrumpeUso() : Boolean
    + {abstract} parametros() : Map<String, String>
    + aOrden() : OrdenComando
    + marcarEntregado() : void
    + registrarResultado(r : ResultadoEjecucion) : void
    + cancelar() : void
    + expirar() : void
    + haExpirado(ahora : DateTime) : Boolean
  }
  class ComandoReinicioApagado <<modificada>> {
    - modo : ModoApagado
  }
  class ComandoInstalacionApp <<modificada>>
  class ComandoActualizacionSO <<modificada>>
  class ComandoFormateo <<modificada>> {
    - nombreConfirmado : String
    + confirmacionValida(e : Equipo) : Boolean
  }
  class ComandoEscritorioRemoto <<modificada>>
  class OrdenComando <<nueva>> {
    + idComando : UUID
    + tipo : TipoAccion
    + parametros : Map<String, String>
    + interrumpeUso : Boolean
    + simulado : Boolean
  }
  class AvisoUsuario <<modificada>> {
    - pospuesto : Boolean = false
    - desenlace : DesenlaceAviso
    + registrarDesenlace(d : DesenlaceAviso) : void
  }
  class CatalogoAplicaciones {
    + contiene(a : AplicacionAprobada) : Boolean
  }
  class AplicacionAprobada {
    - nombre : String
    - identificadorWinget : String
  }
  Comando <|-- ComandoReinicioApagado
  Comando <|-- ComandoInstalacionApp
  Comando <|-- ComandoActualizacionSO
  Comando <|-- ComandoFormateo
  Comando <|-- ComandoEscritorioRemoto
  Comando ..> OrdenComando : <<create>>
  Comando "1" *-- "0..1" AvisoUsuario : muestra >
  CatalogoAplicaciones "1" o-- "0..*" AplicacionAprobada : agrupa >
  ComandoInstalacionApp "0..*" --> "1" AplicacionAprobada : instala >
}

package "Auditoría" {
  class EntradaBitacora {
    - fechaOrden : DateTime
    - fechaResultado : DateTime [0..1]
    - tipoAccion : TipoAccion
    - estadoResultante : EstadoComando
    - nombreUsuario : String
    - nombreEquipo : String
    - cerrada : Boolean = false
    + cerrar(e : EstadoComando, f : DateTime) : void
    + esInmutable() : Boolean
  }
  class FiltroBitacora {
    + esValido() : Boolean
  }
}

Usuario "1" -- "0..*" Comando : ordena >
Equipo "1" -- "0..*" Comando : recibe >
EntradaBitacora "0..1" --> "0..1" Comando : documenta >

note bottom of OrdenComando
  Único tipo que cruza la red hacia el agente
  (contrato de IAgenteAPI). El agente no conoce
  Comando ni sus subclases.
end note
@enduml
