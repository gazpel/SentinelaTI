@startuml secuencia_cu02_l4
' SentinelaTI - Diagrama de secuencia CU02 "Reportar estado del equipo" refinado (L4)
' Render: java -jar plantuml.jar -tpng secuencia_cu02_l4.puml
skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName Calibri
skinparam defaultFontSize 12
skinparam ArrowColor #333333
skinparam maxMessageSize 220
skinparam sequence {
  ParticipantBackgroundColor #EAF4F5
  ParticipantBorderColor #1F6F78
  LifeLineBorderColor #1F6F78
  BoxBackgroundColor #FBFBFB
  BoxBorderColor #1F6F78
  GroupBackgroundColor #EAF4F5
  GroupBorderColor #1F6F78
}

title CU02 — Reportar estado del equipo (refinado L4: recepción y disponibilidad separadas)

box "Equipo cliente" #FFFFFF
  participant "ag:AgenteSentinela" as AG
  participant ":RecolectorMetricas" as REC
  participant "q:ColaLocalLecturas" as COLA
  participant ":ClienteAPI" as CLI
end box
box "Servidor — capa de aplicación" #FFFFFF
  control ":ServicioRecepcionDatos" as SRD
  control ":ServicioEnrolamiento" as SE
  control ":GestorAlertas" as GA
  control ":ServicioDisponibilidad" as SD
end box
box "Servidor — dominio y contratos" #FFFFFF
  entity "e:Equipo" as EQ
  entity ":EquipoRepository" as ER
  entity ":LecturaRepository" as LR
end box

autonumber "<b>0"

loop cada 5 minutos (RF02)
  AG -> REC : componerLectura()
  activate REC
  REC --> AG : l : Lectura
  deactivate REC
  AG -> CLI : postLectura(l)
  activate CLI

  alt no hay conexión con el servidor (excepción 2a, RNF04)
    CLI --> AG : error de red
    AG -> COLA : encolar(l)
    ...al recuperarse la conexión...
    AG -> COLA : pendientes()
    COLA --> AG : lecturas en orden cronológico
    loop por cada lectura pendiente
      AG -> CLI : postLectura(lPendiente)
      AG -> COLA : confirmarEnvio(lPendiente)
    end
  else hay conexión
    CLI -> SRD : recibirLectura(token, l)
    activate SRD
    SRD -> SE : autenticarAgente(token)
    activate SE
    SE -> ER : buscarPorToken(token)
    ER --> SE : e [0..1]
    SE --> SRD : e [0..1]
    deactivate SE

    alt token inválido o revocado (excepción 3a, RNF01)
      SRD --> CLI : HTTP 401 Unauthorized
      CLI --> AG : 401 → volver a CU01
    else token válido
      SRD -> EQ : registrarLectura(l)
      SRD -> LR : agregar(e, l)
      SRD -> GA : evaluar(e, l, cfg)
      activate GA
      GA --> SRD : alertas abiertas o cerradas (RF16)
      deactivate GA
      SRD -> EQ : evaluarEstado(cfg)
      EQ --> SRD : estado (Normal | Advertencia | Critico)
      SRD -> ER : guardar(e)
      note right of ER : El estado queda precalculado\nen Equipo (RNF06, RNF08).
      SRD --> CLI : 200 OK
      deactivate SRD
      CLI --> AG : confirmación de recepción
    end
  end
  deactivate CLI
end

== Tarea periódica independiente (cada 60 s, TareasPeriodicas) ==

SD -> SD : detectarDesconectados()
activate SD
SD -> ER : listarSinReporteDesde(ahora − 3 × intervalo)
ER --> SD : equipos sin reporte
loop por cada equipo sin reporte
  SD -> EQ : marcarDesconectado()
  SD -> ER : guardar(e)
  SD -> GA : registrarDesconexion(e)
  note right of GA : Alerta de desconexión,\nsin duplicar (RF16).
end
deactivate SD
@enduml
