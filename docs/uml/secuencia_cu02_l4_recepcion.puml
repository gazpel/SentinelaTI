@startuml secuencia_cu02_l4_recepcion
' SentinelaTI - CU02 "Reportar estado del equipo" refinado (L4), parte 1: recepción de una lectura
' Render: java -jar plantuml.jar -tpng secuencia_cu02_l4_recepcion.puml
!include estilo_secuencia_l4.iuml

title CU02 refinado (L4) — parte 1: recepción de una lectura (con conexión)

box "Equipo cliente" #FFFFFF
  participant "ag:\nAgenteSentinela" as AG
  participant ":Recolector\nMetricas" as REC
  participant ":ClienteAPI" as CLI
end box
box "Servidor — aplicación" #FFFFFF
  control ":ServicioRecepcion\nDatos" as SRD
  control ":Servicio\nEnrolamiento" as SE
  control ":GestorAlertas" as GA
end box
box "Servidor — dominio" #FFFFFF
  entity "e:Equipo" as EQ
  entity ":Equipo\nRepository" as ER
  entity ":Lectura\nRepository" as LR
end box

autonumber "<b>0"

loop cada 5 minutos (RF02)
  AG -> REC : componerLectura()
  REC --> AG : l : Lectura
  AG -> CLI : postLectura(l)
  activate CLI
    CLI -> SRD : recibirLectura(token, l)
    activate SRD
    SRD -> SE : autenticarAgente(token)
    SE -> ER : buscarPorToken(token)
    ER --> SE : e [0..1]
    SE --> SRD : e [0..1]
    alt token inválido o revocado (excepción 3a, RNF01)
      SRD --> CLI : HTTP 401
      CLI --> AG : 401 → volver a CU01
    else token válido
      SRD -> EQ : registrarLectura(l)
      SRD -> LR : agregar(e, l)
      SRD -> GA : evaluar(e, l, cfg)
      GA --> SRD : alertas abiertas o cerradas (RF16)
      SRD -> EQ : evaluarEstado(cfg)
      EQ --> SRD : Normal | Advertencia | Critico
      SRD -> ER : guardar(e)
      note right of ER : Estado precalculado\n(RNF06, RNF08).
      SRD --> CLI : 200 OK
      deactivate SRD
      CLI --> AG : confirmación
    end
  deactivate CLI
end
@enduml
