@startuml secuencia_cu02
' SentinelaTI - Diagrama de secuencia CU02 "Reportar estado del equipo" (L3)
' Render: java -jar plantuml.jar -tpng secuencia_cu02.puml (no requiere Graphviz)
skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName Calibri
skinparam defaultFontSize 12
skinparam ArrowColor #333333
skinparam maxMessageSize 220
skinparam sequence {
  ParticipantBackgroundColor #EAF4F5
  ParticipantBorderColor #1F6F78
  ActorBackgroundColor #EAF4F5
  ActorBorderColor #1F6F78
  LifeLineBorderColor #1F6F78
  BoxBackgroundColor #FBFBFB
  BoxBorderColor #1F6F78
  GroupBackgroundColor #EAF4F5
  GroupBorderColor #1F6F78
}

title CU02 — Reportar estado del equipo (monitoreo, umbrales y alertas)

box "Equipo cliente" #FFFFFF
  participant "ag:AgenteSentinela" as AG
  participant ":RecolectorMetricas" as REC
  participant "q:ColaLocalLecturas" as COLA
  participant ":ClienteAPI" as CLI
  entity "l:Lectura" as LEC
end box
box "Servidor (API REST)" #FFFFFF
  control ":ServicioMonitoreo" as SM
  entity "e:Equipo" as EQ
  control ":GestorAlertas" as GA
  entity "cfg:ConfiguracionUmbrales" as CFG
  entity "a:Alerta" as AL
end box

autonumber "<b>0"

loop cada 5 minutos (intervalo configurable, RF02)
  AG -> REC : componerLectura()
  activate REC
  REC -> REC : leerCPU(), leerRAM(), leerDiscos(),\nleerHorasEncendido()
  alt el sensor de temperatura está disponible
    REC -> REC : leerTemperatura()
  else no disponible (flujo alternativo 1b)
    REC -> REC : temperaturaCPU := «no disponible»
    note right of REC : Nunca se envía 0 en lugar\nde «no disponible» (RF02).
  end
  REC -> LEC : <<create>> Lectura(marcaTiempo, métricas)
  REC --> AG : l
  deactivate REC

  AG -> CLI : postLectura(l)
  activate CLI

  alt no hay conexión con el servidor (excepción 2a, RNF04)
    CLI --> AG : error de red
    AG -> COLA : encolar(l)
    note right of COLA : Conserva al menos 72 h\nde lecturas (RNF04).
    ...al recuperarse la conexión...
    AG -> COLA : pendientes()
    COLA --> AG : lecturas en orden cronológico
    loop por cada lectura pendiente
      AG -> CLI : postLectura(lPendiente)
      CLI -> SM : POST /lecturas (token, lPendiente)
      SM --> CLI : 200 OK
      AG -> COLA : confirmarEnvio(lPendiente)
    end
  else hay conexión
    CLI -> SM : POST /lecturas (token, l)
    activate SM

    alt el token es inválido o fue revocado (excepción 3a)
      SM --> CLI : HTTP 401 Unauthorized
      CLI --> AG : 401
      AG -> AG : detener envíos y volver a CU01 (enrolar)
    else token válido
      SM -> EQ : registrarLectura(l)
      activate EQ
      EQ --> SM : lectura almacenada
      deactivate EQ

      SM -> GA : evaluar(e, l, cfg)
      activate GA
      loop por cada métrica de la lectura
        GA -> CFG : umbralDe(m)
        CFG --> GA : u : Umbral
        GA -> GA : evaluarMetrica(l, m, u)
        alt supera el umbral crítico y no hay alerta abierta (flujo alternativo 4a, RF16)
          GA -> AL : <<create>> Alerta(e, m, Critico, valor)
        else ya existe una alerta abierta para esa métrica
          GA -> GA : no se duplica la alerta
        else el valor vuelve bajo el umbral y hay alerta abierta (flujo alternativo 4b)
          GA -> AL : cerrar()
        end
      end
      GA --> SM : alertas abiertas o cerradas
      deactivate GA

      SM -> EQ : evaluarEstado(cfg)
      activate EQ
      EQ --> SM : estado : EstadoEquipo\n(Normal | Advertencia | Critico)
      deactivate EQ

      SM --> CLI : 200 OK
      deactivate SM
      CLI --> AG : confirmación de recepción
      deactivate CLI
    end
  end

  opt se cumple además el ciclo diario de 24 h (flujo alternativo 1a, RF03 y RF04)
    AG -> CLI : postInventario(i)
    CLI -> SM : POST /inventario (token, i)
    SM -> EQ : actualizarInventario(i)
    AG -> CLI : postEstadoActualizaciones(eso)
    CLI -> SM : POST /actualizaciones (token, eso)
    SM -> EQ : actualizarEstadoSO(eso)
    SM --> CLI : 200 OK
  end
end

== Regla de negocio: equipo sin reportar ==

SM -> SM : detectarDesconectados()
opt el equipo no reporta durante 3 intervalos seguidos
  SM -> EQ : marcarDesconectado()
  SM -> GA : abrirAlerta(e, —, Critico)
  note right of GA : Alerta de desconexión (RF16).
end
@enduml
